<?xml version="1.0" encoding="utf-8"?>
<!-- Found 2026-11-16: unzipped from the downloaded release, every file carries Windows' "from the internet" mark, and
     .NET Framework then refuses to load pythonnet's Python.Runtime.dll and the WebView2 DLLs: the app window can't
     open ("Failed to resolve Python.Runtime.Loader.Initialize"). This lets the app's own .NET DLLs load anyway. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
